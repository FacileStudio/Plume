# Local dev reference. The API does not read a .env file — export these before
# `go run .`, or source this file yourself.

# Required — the API refuses to start without it.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/plume?sslmode=disable

# The Vite dev proxy targets :4000; tronc's default is 8080, so pin it.
PORT=4000

# Public URL of the client. Used for email links, the OIDC success redirect, and
# as the CORS origin. In dev the browser talks to Vite, which proxies /api, so
# nothing is cross-origin and CORS is not exercised.
# DOMAIN=http://localhost:5173

# Optional — defaults shown.
# APP_ENV=development
# LOG_LEVEL=info
# UPLOAD_DIR=/data/uploads
# SSO_ONLY=false
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# OIDC (optional — enable to use Authentik or any OpenID Connect provider)
# OIDC_ISSUER=https://authentik.yourdomain.com/application/o/plume/
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_REDIRECT_URL=http://localhost:4000/api/auth/oidc/callback
# OIDC_SUCCESS_URL=http://localhost:5173  # defaults to DOMAIN

# Journal log shipping (optional — both must be set or nothing ships).
# JOURNAL_URL=https://journal.facile.studio/api
# JOURNAL_TOKEN=your-journal-key
