# Production template, consumed by docker-compose.

# Required — the API refuses to start without it. docker-compose already sets it
# against the plume-db service; override only to point at another database.
# DATABASE_URL=postgres://postgres:postgres@plume-db:5432/plume?sslmode=disable

# Public URL of the app. Used for the links in signature emails, for the OIDC
# success redirect, and as the CORS origin. CORS_ALLOWED_ORIGINS overrides the
# CORS part only — email links always follow DOMAIN.
DOMAIN=https://app.yourdomain.com

# Optional — defaults shown.
# APP_ENV=production
# PORT=4000                 # tronc defaults to 8080; docker-compose pins 4000
# LOG_LEVEL=info
# UPLOAD_DIR=/data/uploads
# SSO_ONLY=false
# CORS_ALLOWED_ORIGINS=https://app.yourdomain.com

# OIDC (optional — enable to use Authentik or any OpenID Connect provider)
# OIDC_ISSUER=https://authentik.yourdomain.com/application/o/plume/
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_REDIRECT_URL=https://app.yourdomain.com/api/auth/oidc/callback
# OIDC_SUCCESS_URL=https://app.yourdomain.com  # defaults to DOMAIN

# Journal log shipping (optional — both must be set or nothing ships; per-app key
# from the Journal Keys page; Plume reaches Journal over the public URL, not its
# docker network)
# JOURNAL_URL=https://journal.facile.studio/api
# JOURNAL_TOKEN=your-journal-key

# docker-compose only — not read by the API.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=plume
